# Copy to .env and fill in. Placeholders only: never commit real values.

CITEDESK_ENVIRONMENT=local
CITEDESK_LOG_LEVEL=INFO

# Local development services (docker compose)
POSTGRES_DB=citedesk
POSTGRES_USER=citedesk
POSTGRES_PASSWORD=change-me-locally
CITEDESK_POSTGRES_PORT=5434
CITEDESK_DATABASE_URL=postgresql://citedesk:change-me-locally@localhost:5434/citedesk

# Provider keys (leave empty to use mock models in tests)
CITEDESK_OPENAI_API_KEY=
CITEDESK_PINECONE_API_KEY=
CITEDESK_PINECONE_INDEX=cite-desk
CITEDESK_LANGSMITH_API_KEY=

# Authentication: "required" by default. Dev uses a local HS256 secret; production uses an OIDC issuer + JWKS URL.
CITEDESK_AUTH_MODE=required
CITEDESK_JWT_DEV_SECRET=
CITEDESK_OIDC_ISSUER=
CITEDESK_OIDC_JWKS_URL=

# Evaluation budget guards
CITEDESK_EVAL_MAX_JUDGE_CALLS_PER_RUN=300
