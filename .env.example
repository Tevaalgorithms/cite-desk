# Copy to .env and fill in. Placeholders only: never commit real values.

# Database. SQLite works with no setup. Postgres is supported and tested (needs `uv sync --extra postgres`),
# for example:
# CITEDESK_DATABASE_URL=postgresql+psycopg://user:password@host:5432/citedesk
CITEDESK_DATABASE_URL=sqlite:///citedesk.local.db

# Provider keys (leave empty to use mock models in tests)
CITEDESK_OPENAI_API_KEY=
CITEDESK_PINECONE_API_KEY=
CITEDESK_PINECONE_INDEX=cite-desk
CITEDESK_LANGSMITH_API_KEY=

# Which models to use: "offline" (word-matching stand-ins) or "local" (real embedding model and
# cross-encoder; needs `uv sync --extra models`).
CITEDESK_MODELS=offline

# Web API. Sign-in tokens are signed with this secret in local development. Generate a long random
# value, for example: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CITEDESK_JWT_DEV_SECRET=
CITEDESK_CORS_ORIGINS=["http://localhost:3000"]
CITEDESK_ENABLE_API_DOCS=false
CITEDESK_RATE_LIMIT_PER_MINUTE=30

# Planned, not read by the code yet: OIDC sign-in for production.
# CITEDESK_OIDC_ISSUER=
# CITEDESK_OIDC_JWKS_URL=

# Evaluation budget guards
CITEDESK_EVAL_MAX_JUDGE_CALLS_PER_RUN=300
