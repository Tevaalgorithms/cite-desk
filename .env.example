# Copy to .env and fill in. This file holds placeholders only: never put a real key here.
# `.env` is git-ignored. A test fails if a secret-looking value appears in this file.
#
# Lines starting with "#" show an optional setting and its default.
# Production secrets live in AWS SSM Parameter Store, not in a file: see docs/operations/lightsail-deploy.md
# and `uv run citedesk ssm --help`.

# --- Database --------------------------------------------------------------------------------
# SQLite works with no setup. Postgres is supported and tested (needs `uv sync --extra postgres`):
# CITEDESK_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
CITEDESK_DATABASE_URL=sqlite:///citedesk.local.db

# --- Models ----------------------------------------------------------------------------------
# "offline" = word-matching stand-ins (no downloads). "local" = real embedding model and
# cross-encoder on this machine (needs `uv sync --extra models`).
CITEDESK_MODELS=offline

# --- Provider keys (planned: the code does not read these yet) --------------------------------
# They are for the OpenAI answer writer, the Pinecone vector index, RAGAS/DeepEval judging and
# LangSmith tracing. Get your own and keep them only in .env (local) or SSM (production).
CITEDESK_OPENAI_API_KEY=
CITEDESK_PINECONE_API_KEY=
CITEDESK_PINECONE_INDEX=cite-desk
CITEDESK_LANGSMITH_API_KEY=

# --- Web API ---------------------------------------------------------------------------------
# Signs development sign-in tokens. The API refuses to start without it. Generate a long random
# value, for example:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CITEDESK_JWT_DEV_SECRET=
# Browser addresses allowed to call the API (a JSON list).
CITEDESK_CORS_ORIGINS=["http://localhost:3000"]
CITEDESK_ENABLE_API_DOCS=false
CITEDESK_RATE_LIMIT_PER_MINUTE=30
# Planned, not read yet: sign-in through your organization's identity provider (OIDC).
# CITEDESK_OIDC_ISSUER=
# CITEDESK_OIDC_JWKS_URL=

# --- Retrieval and answers (these are the defaults; change only after measuring) ---------------
# CITEDESK_CANDIDATE_LIMIT=20
# CITEDESK_RERANK_POOL=30
# CITEDESK_FINAL_PASSAGE_LIMIT=6
# Leave unset to use the value calibrated for the chosen CITEDESK_MODELS (see docs/evaluation).
# CITEDESK_MIN_RELEVANCE=
# CITEDESK_CHUNK_MAX_CHARS=1200
# CITEDESK_MIN_DOCUMENT_CHARS=100
# CITEDESK_MAX_ANSWER_ATTEMPTS=2

# --- Docker / deployment (read by infrastructure/docker/compose.yml) ----------------------------
# A domain name gets an automatic HTTPS certificate; ":80" serves plain HTTP.
# CITEDESK_SITE=:80
# CITEDESK_HTTP_PORT=80
# CITEDESK_HTTPS_PORT=443
# Password for the bundled trial Postgres (`--profile local-db`). Use a different one in production.
# CITEDESK_LOCAL_DB_PASSWORD=

# --- Evaluation (planned) ----------------------------------------------------------------------
# Upper limit on judge-model calls in one RAGAS/DeepEval run, to cap cost.
CITEDESK_EVAL_MAX_JUDGE_CALLS_PER_RUN=300

# --- Not set here ------------------------------------------------------------------------------
# Web app (apps/web): put NEXT_PUBLIC_API_URL=http://localhost:8010 in apps/web/.env.local if the
# API is not on http://localhost:8000. It is baked in when the web app is built.
# Tests: CITEDESK_TEST_POSTGRES_URL runs the Postgres tests (see tests/integration/test_postgres.py).
