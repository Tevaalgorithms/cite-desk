# One address for everything: the API paths go to the API, the rest to the web app.
# CITEDESK_SITE is a domain name (Caddy then gets a TLS certificate automatically) or ":80" for plain HTTP.
{$CITEDESK_SITE::80} {
	encode gzip

	@api path /v1/* /health /ready
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
